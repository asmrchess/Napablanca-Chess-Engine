// ------------------------------------------------------------
// MOVE-ORDERING MEMORY (killer moves, history heuristic, root PV reuse)
// ------------------------------------------------------------
// Killer moves: two "slots" per remaining-depth level, remembering quiet
// moves that caused a beta cutoff at that depth level in some OTHER branch
// of the tree. A move that worked as a refutation once is a good first
// guess elsewhere at the same depth, even in a totally different position,
// because it's often a generally-dangerous square/piece combination (e.g.
// a knight fork square) rather than something tied to the exact position.
// Indexed by remaining search depth, capped at KILLER_SLOTS levels (deep
// enough for the max depth findBestMoveTimed uses plus check extensions).
let KILLER_SLOTS = 32
let killerFrom1: number[] = []
let killerTo1: number[] = []
let killerFrom2: number[] = []
let killerTo2: number[] = []

// History heuristic: how often a quiet move has caused a beta cutoff
// anywhere in the current search, weighted by how deep that cutoff was (a
// cutoff found deep in the tree is a stronger signal than a shallow one).
// Indexed by [moving piece type, to-square] rather than the classic
// [from-square, to-square] -- 6*64 = 384 entries instead of 64*64 = 4096.
// This loses a little precision (two different pawns going to the same
// square share a slot) but is a well-known, perfectly reasonable variant
// of the history heuristic, and on this device the 11x smaller table is
// the difference between fitting in memory and not: even AFTER the
// allocate-once fix below, hardware testing showed a 4096-entry table
// alone was enough to exhaust the device's available RAM while it was
// being built (confirmed by progress logging over serial: it consistently
// died around index ~2300 of 4096, partway through, not instantly and not
// right at the end -- the signature of genuinely running out of heap
// during the array's growth, not a bug in the loop itself). Index formula:
// (pieceType - 1) * 64 + toSquare, where pieceType is Math.abs(board value)
// in 1..6 (PAWN..KING). Reset once per real move decision (each
// findBestMoveTimed call) rather than kept across the whole game, so it
// can't carry stale bias from a completely different position.
let HISTORY_TABLE_SIZE = 384
let historyTable: number[] = []

// Root-move reuse across iterative deepening: the best move found by the
// PREVIOUS (shallower) completed depth is tried first at the next depth,
// since it's usually still a very strong candidate and a cheap, low-risk
// stand-in for a full transposition table. Reset per move decision.
let rootPVFrom = -1
let rootPVTo = -1

// Check extensions: search one extra ply (without spending depth budget)
// when the side to move is in check, since check positions have few legal
// replies and often hide forced tactics right at the search horizon. Capped
// per search line so a long sequence of checks can't blow up the time
// budget.
let MAX_CHECK_EXTENSIONS = 4

// Fills the killer/history/root-PV move-ordering memory with real,
// explicit default values (rather than leaving the arrays empty and
// relying on out-of-bounds reads quietly returning something sane -- that
// works in a Node.js test harness but isn't something to rely on for the
// real compiled-for-hardware target, and an uninitialized history slot
// read as `undefined` would poison every ordering score it's added to).
// Called once at the start of the game and again at the start of every
// findBestMoveTimed call, so stale move-ordering hints from a completely
// different position never carry over into the next real move decision.
//
// Rebuilding historyTable from an empty array via repeated pushes every
// single call -- which is what this used to do -- means repeatedly growing
// an array (many internal reallocate-and-copy steps along the way) and
// discarding the old one as garbage, right at the start of every real move
// and every new game. On a memory-tight device that is a large, sudden
// allocation at exactly the moment a game starts -- a strong match for a
// panic that happens right as the board is about to appear. Fixed the same
// way as the pool buffers: allocate the HISTORY_TABLE_SIZE (and 32-ish
// killer) slots ONCE, and every later call just resets their existing
// contents in place. (This allocate-once fix alone was NOT enough while
// the table was still 4096 entries -- see the comment on historyTable's
// declaration above -- so the table was also shrunk to 384 entries.)
let searchMemoryReady = false
function resetSearchMemory (): void {
    if (!searchMemoryReady) {
        searchMemoryReady = true
        for (let ki = 0; ki < KILLER_SLOTS; ki++) {
            killerFrom1.push(-1)
            killerTo1.push(-1)
            killerFrom2.push(-1)
            killerTo2.push(-1)
        }
        for (let hi = 0; hi < HISTORY_TABLE_SIZE; hi++) {
            historyTable.push(0)
        }
    } else {
        for (let ki = 0; ki < KILLER_SLOTS; ki++) {
            killerFrom1[ki] = -1
            killerTo1[ki] = -1
            killerFrom2[ki] = -1
            killerTo2[ki] = -1
        }
        for (let hi = 0; hi < HISTORY_TABLE_SIZE; hi++) {
            historyTable[hi] = 0
        }
    }
    rootPVFrom = -1
    rootPVTo = -1
}

