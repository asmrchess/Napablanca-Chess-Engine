// ============================================================
// PHYSICAL GAME: OLED display + joystick:bit input
//
// Requires two MakeCode extensions to be added first (gearwheel
// menu -> Extensions -> search and add each one):
//   - "128x64Display"  (KitronikLtd, for the :VIEW 128x64 OLED)
//   - "joystickbit"    (ELECFREAKS, for the joystick:bit)
//
// Board is shown as 8 text lines (rank 8 at the top, rank 1 at
// the bottom -- the normal orientation from White's point of
// view). Each square is 3 characters wide: " P " for a normal
// square, "[P]" for the square the cursor is on, "(P)" for the
// square you've picked up a piece from, and "{P}" when the
// cursor is sitting on the square you've picked up.
// Uppercase letters = White, lowercase = Black, "." = empty.
//
// Controls: move the joystick to move the cursor one square at
// a time (release back to centre before it will move again).
// Press C (joystick:bit) to pick up the piece under the cursor,
// move the cursor to where you want it to go, and press D
// (joystick:bit) to drop it there and play the move. Press D on
// the same square you picked up to cancel, or press C on a
// different one of your own pieces to change your selection.
// Press B (the micro:bit's own button) at any time to cancel a
// selection outright.
//
// While the engine is thinking, the micro:bit's 5x5 LED grid fills up
// (roughly one more LED per 1/25th of whatever think-time is currently
// configured) so you can see how much of its thinking time is left.
//
// You play White; the engine plays Black and thinks for however long the
// Strength menu is set to (2-120 seconds, default 35).
//
// While it's your move, press E (joystick:bit) to see the engine's last
// move (in long algebraic notation) and the current static evaluation of
// the position, from White's point of view (positive = good for White).
//
// If the cursor moves the wrong way compared to the joystick,
// flip INVERT_X and/or INVERT_Y below and re-flash.
// ============================================================

let INVERT_X = false
let INVERT_Y = false
let JOY_LOW = 300
let JOY_HIGH = 700

// Auto-repeat: holding the joystick in a direction (rather than tapping
// it) moves once immediately, waits JOY_REPEAT_DELAY_MS to make sure it's
// a genuine hold and not just a slightly-long tap, then keeps moving
// every JOY_REPEAT_INTERVAL_MS for as long as it's held -- instead of
// requiring the stick to be recentered and re-pushed for every single
// step, which was painfully slow for anything more than 3-4 steps (the
// value picker's 1-600 second range being the case that made this
// obvious).
let JOY_REPEAT_DELAY_MS = 400
let JOY_REPEAT_INTERVAL_MS = 120

let cursorRow = 7
let cursorCol = 4
let selectedFrom = -1
let lastXDir = 0
let lastYDir = 0
let xNextRepeatTime = 0
let yNextRepeatTime = 0
let lastCPressed = false
let lastDPressed = false
let lastBPressed = false
let lastEPressed = false

// ------------------------------------------------------------
// MENU / CONFIGURATION STATE
// ------------------------------------------------------------
// How long (ms) the engine thinks per move in a normal human-vs-engine
// game, set from the "Strength" menu. Replaces what used to be a hardcoded
// 35000 passed straight to findBestMoveTimed().
let aiThinkMillis = 35000

// Self-play configuration, set from the "Self Play" menu.
// selfPlayMode: 0 = fixed ply depth (findBestMove), 1 = fixed time per
// move (findBestMoveTimed) -- these are genuinely different engine calls,
// not just the same search with a different stopping rule, so self-play
// can be used to compare "how strong is depth N" against "how strong is N
// seconds of iterative deepening" on real hardware.
let selfPlayMode = 1
let selfPlayDepth = 3
let selfPlayMillis = 5000

// Long-algebraic text for the engine's most recent move, shown on demand
// (press E during your own move) rather than automatically, so it doesn't
// interrupt normal play.
let lastEngineMoveText = "none yet"

function pieceChar (p: number): string {
    let a = Math.abs(p)
    let ch = "."
    if (a == PAWN) {
        ch = p > 0 ? "P" : "p"
    } else if (a == KNIGHT) {
        ch = p > 0 ? "N" : "n"
    } else if (a == BISHOP) {
        ch = p > 0 ? "B" : "b"
    } else if (a == ROOK) {
        ch = p > 0 ? "R" : "r"
    } else if (a == QUEEN) {
        ch = p > 0 ? "Q" : "q"
    } else if (a == KING) {
        ch = p > 0 ? "K" : "k"
    }
    return ch
}

function buildBoardLine (rowIndex: number): string {
    let line = ""
    for (let colIndex = 0; colIndex <= 7; colIndex++) {
        let sqIdx = squareFromRC(rowIndex, colIndex)
        let ch = pieceChar(board[sqIdx])
        let isCursor = rowIndex == cursorRow && colIndex == cursorCol
        let isSelected = selectedFrom == sqIdx
        if (isCursor && isSelected) {
            line = line + "{" + ch + "}"
        } else if (isCursor) {
            line = line + "[" + ch + "]"
        } else if (isSelected) {
            line = line + "(" + ch + ")"
        } else {
            line = line + " " + ch + " "
        }
    }
    return line
}

function drawBoardLine (rowIndex: number): void {
    let text = buildBoardLine(rowIndex)
    kitronik_VIEW128x64.clearLine(rowIndex + 1)
    kitronik_VIEW128x64.show(text, rowIndex + 1)
}

function drawBoard (): void {
    for (let ln = 0; ln <= 7; ln++) {
        drawBoardLine(ln)
    }
}

function showStatus (line1: string, line2: string, line3: string): void {
    kitronik_VIEW128x64.clear()
    kitronik_VIEW128x64.show(line1, 3)
    kitronik_VIEW128x64.show(line2, 4)
    kitronik_VIEW128x64.show(line3, 5)
}

// Formats a centipawn score as a signed pawns-and-hundredths string, e.g.
// 135 -> "+1.35", -40 -> "-0.40", 0 -> "+0.00". Positive = good for White.
// Built with plain arithmetic and string concatenation (no toFixed/etc,
// matching the rest of this file's MakeCode-safe style).
function formatEvalCentipawns (score: number): string {
    let sign = score < 0 ? "-" : "+"
    let mag = Math.abs(score)
    let whole = Math.floor(mag / 100)
    let frac = mag % 100
    let fracStr = frac < 10 ? "0" + frac : "" + frac
    return sign + whole + "." + fracStr
}

