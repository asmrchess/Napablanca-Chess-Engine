// Set to true by runValuePicker() when the player backs out with B,
// instead of confirming with C, so the caller knows to abandon whatever
// it was about to configure rather than use the returned value.
let menuCancelled = false

function drawMenuList (title: string, options: string[], selIndex: number): void {
    kitronik_VIEW128x64.clear()
    kitronik_VIEW128x64.show(title, 1)
    for (let i = 0; i <= options.length - 1; i++) {
        let line = (i == selIndex ? "> " : "  ") + options[i]
        kitronik_VIEW128x64.show(line, 3 + i)
    }
}

// Redraws just the two lines whose ">" marker actually changed, instead
// of a full clear() plus re-showing every option -- same reasoning as
// updateValuePickerValue below. The title and every non-affected option
// line stay exactly as they were on screen.
function updateMenuSelection (options: string[], prevIndex: number, newIndex: number): void {
    if (prevIndex == newIndex) {
        return
    }
    kitronik_VIEW128x64.clearLine(3 + prevIndex)
    kitronik_VIEW128x64.show("  " + options[prevIndex], 3 + prevIndex)
    kitronik_VIEW128x64.clearLine(3 + newIndex)
    kitronik_VIEW128x64.show("> " + options[newIndex], 3 + newIndex)
}

// Simple joystick-driven list menu: Y moves the highlight up/down
// (wrapping), C confirms. Returns the chosen option's index.
function runMenu (title: string, options: string[], startIndex: number): number {
    let selIndex = startIndex
    let lastY = 0
    let yNextRepeat = 0
    let cLast = joystickbit.getButton(joystickbit.JoystickBitPin.P12)
    drawMenuList(title, options, selIndex)
    while (true) {
        let y = joystickbit.getRockerValue(joystickbit.rockerType.Y)
        let yDir = 0
        if (y < JOY_LOW) { yDir = -1 } else if (y > JOY_HIGH) { yDir = 1 }
        if (INVERT_Y) { yDir = 0 - yDir }

        let now = input.runningTime()
        let prevSelIndex = selIndex
        let moved = false
        if (yDir != 0) {
            if (lastY == 0) {
                selIndex = selIndex + yDir
                yNextRepeat = now + JOY_REPEAT_DELAY_MS
                moved = true
            } else if (yDir == lastY && now >= yNextRepeat) {
                selIndex = selIndex + yDir
                yNextRepeat = now + JOY_REPEAT_INTERVAL_MS
                moved = true
            }
            if (selIndex < 0) { selIndex = options.length - 1 }
            if (selIndex >= options.length) { selIndex = 0 }
        }
        lastY = yDir

        let cNow = joystickbit.getButton(joystickbit.JoystickBitPin.P12)
        let cPressed = cNow && !(cLast)
        cLast = cNow

        if (moved) { updateMenuSelection(options, prevSelIndex, selIndex) }
        if (cPressed) { return selIndex }
        basic.pause(100)
    }
}

function drawValuePicker (title: string, value: number, unitLabel: string): void {
    kitronik_VIEW128x64.clear()
    kitronik_VIEW128x64.show(title, 2)
    kitronik_VIEW128x64.show("" + value + " " + unitLabel, 4)
    kitronik_VIEW128x64.show("Y:+/- C:OK B:back", 6)
}

// Only the value line actually changes as you turn the joystick -- the
// title and instructions never do -- so redrawing the whole screen (a
// full clear() plus re-showing all 3 lines) on every single step was
// pure waste, and with auto-repeat now firing every 120ms while held,
// that waste was the actual bottleneck on how fast the value could
// change. This updates just line 4.
function updateValuePickerValue (value: number, unitLabel: string): void {
    kitronik_VIEW128x64.clearLine(4)
    kitronik_VIEW128x64.show("" + value + " " + unitLabel, 4)
}

// Joystick-driven numeric picker: Y up/down adjusts the value by `step`
// (clamped to [minValue, maxValue]), C confirms and returns the value, B
// cancels (sets menuCancelled = true and returns the value unchanged --
// callers must check menuCancelled rather than trust the return alone).
function runValuePicker (title: string, initialValue: number, minValue: number, maxValue: number, step: number, unitLabel: string): number {
    let value = initialValue
    let lastY = 0
    let yNextRepeat = 0
    let cLast = joystickbit.getButton(joystickbit.JoystickBitPin.P12)
    let bLast = input.buttonIsPressed(Button.B)
    menuCancelled = false
    drawValuePicker(title, value, unitLabel)
    while (true) {
        let y = joystickbit.getRockerValue(joystickbit.rockerType.Y)
        let yDir = 0
        if (y < JOY_LOW) { yDir = -1 } else if (y > JOY_HIGH) { yDir = 1 }
        if (INVERT_Y) { yDir = 0 - yDir }

        let now = input.runningTime()
        let moved = false
        if (yDir != 0) {
            if (lastY == 0) {
                value = value - yDir * step
                yNextRepeat = now + JOY_REPEAT_DELAY_MS
                moved = true
            } else if (yDir == lastY && now >= yNextRepeat) {
                value = value - yDir * step
                yNextRepeat = now + JOY_REPEAT_INTERVAL_MS
                moved = true
            }
            if (value < minValue) { value = minValue }
            if (value > maxValue) { value = maxValue }
        }
        lastY = yDir

        let cNow = joystickbit.getButton(joystickbit.JoystickBitPin.P12)
        let cPressed = cNow && !(cLast)
        cLast = cNow

        let bNow = input.buttonIsPressed(Button.B)
        let bPressed = bNow && !(bLast)
        bLast = bNow

        if (moved) { updateValuePickerValue(value, unitLabel) }
        if (cPressed) { return value }
        if (bPressed) { menuCancelled = true; return value }
        basic.pause(100)
    }
}

function squareOwnedBySideToMove (sqIdx: number): boolean {
    let p = board[sqIdx]
    if (p == EMPTY) {
        return false
    }
    if (whiteToMove) {
        return p > 0
    } else {
        return p < 0
    }
}

function squareHasLegalMoveFrom (square: number): boolean {
    for (let i = 0; i <= movesFrom.length - 1; i++) {
        if (movesFrom[i] == square) {
            return true
        }
    }
    return false
}

function findLegalMoveIndex (fromSq: number, toSq: number): number {
    for (let i = 0; i <= movesFrom.length - 1; i++) {
        if (movesFrom[i] == fromSq && movesTo[i] == toSq) {
            return i
        }
    }
    return -1
}

// Reads the joystick and moves the cursor by at most one square
// per call. Requires the stick to pass back through the centre
// dead zone before it will register another move in the same
// direction, so holding it over doesn't cause runaway movement.
// Returns true if the cursor actually moved.
function pollJoystickCursor (): boolean {
    let x = joystickbit.getRockerValue(joystickbit.rockerType.X)
    let y = joystickbit.getRockerValue(joystickbit.rockerType.Y)
    let xDir = 0
    if (x < JOY_LOW) {
        xDir = -1
    } else if (x > JOY_HIGH) {
        xDir = 1
    }
    let yDir = 0
    if (y < JOY_LOW) {
        yDir = -1
    } else if (y > JOY_HIGH) {
        yDir = 1
    }
    if (INVERT_X) {
        xDir = 0 - xDir
    }
    if (INVERT_Y) {
        yDir = 0 - yDir
    }

    let now = input.runningTime()
    let moved = false
    if (xDir != 0) {
        if (lastXDir == 0) {
            cursorCol = cursorCol + xDir
            xNextRepeatTime = now + JOY_REPEAT_DELAY_MS
            moved = true
        } else if (xDir == lastXDir && now >= xNextRepeatTime) {
            cursorCol = cursorCol + xDir
            xNextRepeatTime = now + JOY_REPEAT_INTERVAL_MS
            moved = true
        }
        if (cursorCol < 0) { cursorCol = 0 }
        if (cursorCol > 7) { cursorCol = 7 }
    }
    if (yDir != 0) {
        if (lastYDir == 0) {
            cursorRow = cursorRow + yDir
            yNextRepeatTime = now + JOY_REPEAT_DELAY_MS
            moved = true
        } else if (yDir == lastYDir && now >= yNextRepeatTime) {
            cursorRow = cursorRow + yDir
            yNextRepeatTime = now + JOY_REPEAT_INTERVAL_MS
            moved = true
        }
        if (cursorRow < 0) { cursorRow = 0 }
        if (cursorRow > 7) { cursorRow = 7 }
    }
    lastXDir = xDir
    lastYDir = yDir
    return moved
}

// Blocks until the human player (White) has made a legal move,
// then applies it with makeMove() and returns. Assumes
// generateLegalMoves(whiteToMove) has already been called by the
// caller so movesFrom/movesTo hold White's current legal moves.
function waitForPlayerMove (): void {
    selectedFrom = -1
    drawBoard()
    while (true) {
        let priorCursorRow = cursorRow
        let moved = pollJoystickCursor()
        // C (joystick:bit) = pick up / switch selection. D (joystick:bit) =
        // drop onto the cursor's square. B (micro:bit onboard) = cancel.
        let cNow = joystickbit.getButton(joystickbit.JoystickBitPin.P12)
        let dNow = joystickbit.getButton(joystickbit.JoystickBitPin.P13)
        let eNow = joystickbit.getButton(joystickbit.JoystickBitPin.P14)
        let bNow = input.buttonIsPressed(Button.B)
        let cPressed = cNow && !(lastCPressed)
        let dPressed = dNow && !(lastDPressed)
        let ePressed = eNow && !(lastEPressed)
        let bPressed = bNow && !(lastBPressed)
        lastCPressed = cNow
        lastDPressed = dNow
        lastEPressed = eNow
        lastBPressed = bNow

        if (ePressed) {
            // Info overlay: doesn't touch board/selection state, so once
            // it's dismissed we just redraw the board and carry on.
            showStatus("Engine played:", lastEngineMoveText, "Eval: " + formatEvalCentipawns(evaluate()))
            basic.pause(2500)
            drawBoard()
        }

        // Tracked separately from plain cursor movement: a selection
        // change can mark up a square on a totally different row than
        // the cursor (the piece you picked up stays marked while you
        // move the cursor elsewhere to choose where to drop it), so it
        // still gets a full, guaranteed-correct drawBoard(). That's fine
        // performance-wise -- C/D/B are single presses, not something
        // auto-repeat fires many times a second the way cursor movement
        // now does.
        let selectionChanged = false

        if (bPressed && selectedFrom >= 0) {
            selectedFrom = -1
            selectionChanged = true
        }

        if (cPressed) {
            let sqIdx = squareFromRC(cursorRow, cursorCol)
            if (sqIdx != selectedFrom && squareOwnedBySideToMove(sqIdx) && squareHasLegalMoveFrom(sqIdx)) {
                selectedFrom = sqIdx
                selectionChanged = true
            }
        }

        if (dPressed && selectedFrom >= 0) {
            let sqIdx = squareFromRC(cursorRow, cursorCol)
            if (sqIdx == selectedFrom) {
                selectedFrom = -1
                selectionChanged = true
            } else {
                let idx = findLegalMoveIndex(selectedFrom, sqIdx)
                if (idx >= 0) {
                    makeMove(idx)
                    recordPosition((captured != EMPTY) || (Math.abs(piece2) == PAWN))
                    selectedFrom = -1
                    if (inCheck(whiteToMove)) {
                        showStatus("Check!", "", "")
                        basic.pause(800)
                    }
                    return
                }
                // Not a legal target for the piece we're holding -- ignored,
                // selection stays put. Press C on a different own piece to
                // switch what's picked up, or B to cancel.
            }
        }

        if (selectionChanged) {
            drawBoard()
        } else if (moved) {
            // Pure cursor movement: only the row(s) the cursor actually
            // left/entered changed on screen -- everything else on the
            // board (including up to 7 other rows) is exactly as it was,
            // so redrawing it is wasted OLED time. This is the path
            // auto-repeat hits repeatedly while the joystick is held,
            // so it's the one that matters most for feel.
            if (cursorRow != priorCursorRow) {
                drawBoardLine(priorCursorRow)
                drawBoardLine(cursorRow)
            } else {
                drawBoardLine(cursorRow)
            }
        }
        basic.pause(100)
    }
}

function playPhysicalGame (): void {
    resetBoard()
    joystickbit.initJoystickBit()
    cursorRow = 7
    cursorCol = 4
    selectedFrom = -1
    lastXDir = 0
    lastYDir = 0
    xNextRepeatTime = 0
    yNextRepeatTime = 0
    lastCPressed = joystickbit.getButton(joystickbit.JoystickBitPin.P12)
    lastDPressed = joystickbit.getButton(joystickbit.JoystickBitPin.P13)
    lastEPressed = joystickbit.getButton(joystickbit.JoystickBitPin.P14)
    lastBPressed = input.buttonIsPressed(Button.B)
    lastEngineMoveText = "none yet"

    while (true) {
        generateLegalMoves(whiteToMove)
        if (movesFrom.length == 0) {
            if (inCheck(whiteToMove)) {
                if (whiteToMove) {
                    showStatus("Checkmate!", "Black wins", "")
                } else {
                    showStatus("Checkmate!", "White wins", "")
                }
            } else {
                showStatus("Stalemate", "It's a draw", "")
            }
            break
        }
        if (countRepetitions(positionKey()) >= 3) {
            showStatus("Draw by", "repetition", "")
            break
        }
        if (whiteToMove) {
            waitForPlayerMove()
        } else {
            showStatus("AI is", "thinking...", "(up to " + Math.floor(aiThinkMillis / 1000) + "s)")
            aiMove = findBestMoveTimed(aiThinkMillis)
            lastEngineMoveText = moveName(aiMove)
            makeMove(aiMove)
            recordPosition((captured != EMPTY) || (Math.abs(piece2) == PAWN))
            if (inCheck(whiteToMove)) {
                showStatus("Check!", "", "")
                basic.pause(800)
            }
        }
    }
    basic.pause(4000)
}

// ------------------------------------------------------------
// SELF-PLAY MODE (engine vs itself, for benchmarking on real hardware)
// ------------------------------------------------------------
function runSelfPlayGame (): void {
    resetBoard()
    joystickbit.initJoystickBit()
    lastBPressed = input.buttonIsPressed(Button.B)

    while (true) {
        generateLegalMoves(whiteToMove)
        if (movesFrom.length == 0) {
            if (inCheck(whiteToMove)) {
                if (whiteToMove) {
                    showStatus("Checkmate!", "Black wins", "")
                } else {
                    showStatus("Checkmate!", "White wins", "")
                }
            } else {
                showStatus("Stalemate", "It's a draw", "")
            }
            break
        }
        if (countRepetitions(positionKey()) >= 3) {
            showStatus("Draw by", "repetition", "")
            break
        }
        drawBoard()
        // Give the player a chance to bail out before the engine commits
        // to what might be a long think -- self-play games have no other
        // way to interrupt them.
        let bNow = input.buttonIsPressed(Button.B)
        let bPressed = bNow && !(lastBPressed)
        lastBPressed = bNow
        if (bPressed) {
            showStatus("Self-play", "stopped", "")
            break
        }

        let mv = 0
        if (selfPlayMode == 0) {
            mv = findBestMove(selfPlayDepth)
        } else {
            mv = findBestMoveTimed(selfPlayMillis)
        }
        lastEngineMoveText = moveName(mv)
        makeMove(mv)
        recordPosition((captured != EMPTY) || (Math.abs(piece2) == PAWN))
    }
    basic.pause(4000)
}

