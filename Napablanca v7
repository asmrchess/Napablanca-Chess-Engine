// ------------------------------------------------------------
// BOARD / SQUARE HELPERS
// ------------------------------------------------------------
function squareFromRC (r: number, c: number) {
    return r * 8 + c
}

function row (square: number) {
    return Math.idiv(square, 8)
}

function col (square: number) {
    return square % 8
}

function onBoard (r: number, c: number) {
    return r >= 0 && r < 8 && c >= 0 && c < 8
}

function isWhite (piece: number) {
    return piece > 0
}

function isBlack (piece: number) {
    return piece < 0
}

function squareName (square: number) {
    files = "abcdefgh"
    file = files.charAt(col(square))
    rank = "" + (8 - row(square))
    return "" + file + rank
}

function squareFromName (name: string) {
    files2 = "abcdefgh"
    file2 = files2.indexOf(name.charAt(0))
    rank2 = parseInt(name.charAt(1))
    if (file2 < 0 || rank2 < 1 || rank2 > 8) {
        return -1
    }
    return (8 - rank2) * 8 + file2
}

function copyBoard () {
    // Reuses this ply's preallocated slot instead of allocating a new
    // 64-element array every time -- see the PER-PLY REUSABLE BUFFERS
    // note near the top of the file. initPools() is cheap to call
    // repeatedly (it no-ops after the first time) and guarantees the
    // pools exist no matter which function gets called first.
    initPools()
    let result = boardPool[searchPly]
    // Growing an array past its current length only via push() (never by
    // assigning an out-of-range index, and never by setting .length --
    // the real MakeCode compile target has no shim for that) is the only
    // array-growth operation this project has confirmed works on-device.
    // The first time a given ply's slot is used it's empty, so every
    // write here goes through push(); every reuse after that it's
    // already 64 long, so every write is a plain, safely in-bounds
    // index assignment -- no further growth, no reallocation.
    for (let o = 0; o <= 63; o++) {
        if (o < result.length) {
            result[o] = board[o]
        } else {
            result.push(board[o])
        }
    }
    return result
}

// Restores `board` from a snapshot taken by copyBoard(), by copying its
// contents back element-by-element instead of `board = saved` (a
// reference reassignment). That distinction matters now that copyBoard()
// hands out a reused pool slot rather than a fresh array: if restore just
// repointed `board` at that same slot, `board` and the pool slot would
// become the SAME object, so the very next copyBoard() at this ply would
// silently snapshot nothing (copying the slot onto itself), and the move
// made after it would corrupt the "saved" state instead of leaving it
// intact to restore from. Copying contents back keeps `board` a single
// stable array for the whole program, always genuinely independent of
// whatever the pools are holding.
function restoreBoard (saved: number[]): void {
    for (let o = 0; o <= 63; o++) {
        board[o] = saved[o]
    }
}

function pieceValue (piece: number) {
    a = Math.abs(piece)
    if (a == PAWN) {
        return 100
    }
    if (a == KNIGHT) {
        return 320
    }
    if (a == BISHOP) {
        return 330
    }
    if (a == ROOK) {
        return 500
    }
    if (a == QUEEN) {
        return 900
    }
    if (a == KING) {
        return 20000
    }
    return 0
}

function findKing (white: boolean) {
    let wanted = white ? KING : -KING
    for (let l = 0; l <= 63; l++) {
        if (board[l] == wanted) {
            return l
        }
    }
    return -1
}

// ------------------------------------------------------------
// ATTACK DETECTION
// ------------------------------------------------------------
function squareAttacked (square: number, byWhite: boolean) {
    r2 = row(square)
    c2 = col(square)
    // PAWNS
    if (byWhite) {
        if (onBoard(r2 + 1, c2 - 1)) {
            if (board[squareFromRC(r2 + 1, c2 - 1)] == PAWN) {
                return true
            }
        }
        if (onBoard(r2 + 1, c2 + 1)) {
            if (board[squareFromRC(r2 + 1, c2 + 1)] == PAWN) {
                return true
            }
        }
    } else {
        if (onBoard(r2 - 1, c2 - 1)) {
            if (board[squareFromRC(r2 - 1, c2 - 1)] == 0 - PAWN) {
                return true
            }
        }
        if (onBoard(r2 - 1, c2 + 1)) {
            if (board[squareFromRC(r2 - 1, c2 + 1)] == 0 - PAWN) {
                return true
            }
        }
    }
    // KNIGHTS
    // knightR/knightC are filled once at the top of the file (constant
    // values) -- no need to rebuild them here every call.
    for (let m = 0; m <= 7; m++) {
        nr = r2 + knightR[m]
        nc = c2 + knightC[m]
        if (onBoard(nr, nc)) {
            p2 = board[squareFromRC(nr, nc)]
            if (byWhite && p2 == KNIGHT) {
                return true
            }
            if (!(byWhite) && p2 == 0 - KNIGHT) {
                return true
            }
        }
    }
    // BISHOPS / QUEENS
    // diagR/diagC are filled once at the top of the file -- constant.
    for (let d = 0; d <= 3; d++) {
        nr2 = r2 + diagR[d]
        nc2 = c2 + diagC[d]
        while (onBoard(nr2, nc2)) {
            q2 = board[squareFromRC(nr2, nc2)]
            if (q2 != EMPTY) {
                if (byWhite && (q2 == BISHOP || q2 == QUEEN)) {
                    return true
                }
                if (!(byWhite) && (q2 == 0 - BISHOP || q2 == 0 - QUEEN)) {
                    return true
                }
                break;
            }
            nr2 += diagR[d]
            nc2 += diagC[d]
        }
    }
    // ROOKS / QUEENS
    // straightR/straightC are filled once at the top of the file -- constant.
    for (let e = 0; e <= 3; e++) {
        nr3 = r2 + straightR[e]
        nc3 = c2 + straightC[e]
        while (onBoard(nr3, nc3)) {
            c = board[squareFromRC(nr3, nc3)]
            if (c != EMPTY) {
                if (byWhite && (c == ROOK || c == QUEEN)) {
                    return true
                }
                if (!(byWhite) && (c == 0 - ROOK || c == 0 - QUEEN)) {
                    return true
                }
                break;
            }
            nr3 += straightR[e]
            nc3 += straightC[e]
        }
    }
    // KINGS
    for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
            if (dr == 0 && dc == 0) {
                continue
            }
            let nr4 = r2 + dr
            let nc4 = c2 + dc
            if (onBoard(nr4, nc4)) {
                let t = board[squareFromRC(nr4, nc4)]
                if (byWhite && t == KING) {
                    return true
                }
                if (!byWhite && t == -KING) {
                    return true
                }
            }
        }
    }
    return false
}

// Returns the square of the LEAST valuable piece of `byWhite`'s color that
// attacks `square` on the CURRENT `board`, or -1 if none does. Mirrors
// squareAttacked's scan exactly (same piece-by-piece logic), but instead of
// stopping at the first attacker found, it keeps the cheapest one -- used
// by static exchange evaluation (SEE) below, which always wants to know
// "what's the least valuable thing that could recapture here?"
function leastValuableAttacker (square: number, byWhite: boolean) {
    let bestFrom = -1
    let bestValue = 999999
    r2 = row(square)
    c2 = col(square)
    // Pawns
    if (byWhite) {
        if (onBoard(r2 + 1, c2 - 1) && board[squareFromRC(r2 + 1, c2 - 1)] == PAWN) {
            bestFrom = squareFromRC(r2 + 1, c2 - 1); bestValue = pieceValue(PAWN)
        }
        if (onBoard(r2 + 1, c2 + 1) && board[squareFromRC(r2 + 1, c2 + 1)] == PAWN) {
            if (pieceValue(PAWN) < bestValue) { bestFrom = squareFromRC(r2 + 1, c2 + 1); bestValue = pieceValue(PAWN) }
        }
    } else {
        if (onBoard(r2 - 1, c2 - 1) && board[squareFromRC(r2 - 1, c2 - 1)] == 0 - PAWN) {
            bestFrom = squareFromRC(r2 - 1, c2 - 1); bestValue = pieceValue(PAWN)
        }
        if (onBoard(r2 - 1, c2 + 1) && board[squareFromRC(r2 - 1, c2 + 1)] == 0 - PAWN) {
            if (pieceValue(PAWN) < bestValue) { bestFrom = squareFromRC(r2 - 1, c2 + 1); bestValue = pieceValue(PAWN) }
        }
    }
    // Knights
    // knightR/knightC are filled once at the top of the file (constant
    // values) -- no need to rebuild them here every call.
    for (let m = 0; m <= 7; m++) {
        nr = r2 + knightR[m]
        nc = c2 + knightC[m]
        if (onBoard(nr, nc)) {
            p2 = board[squareFromRC(nr, nc)]
            if (byWhite && p2 == KNIGHT) {
                if (pieceValue(KNIGHT) < bestValue) { bestFrom = squareFromRC(nr, nc); bestValue = pieceValue(KNIGHT) }
            }
            if (!(byWhite) && p2 == 0 - KNIGHT) {
                if (pieceValue(KNIGHT) < bestValue) { bestFrom = squareFromRC(nr, nc); bestValue = pieceValue(KNIGHT) }
            }
        }
    }
    // Bishops / queens
    // diagR/diagC are filled once at the top of the file -- constant.
    for (let d = 0; d <= 3; d++) {
        nr2 = r2 + diagR[d]
        nc2 = c2 + diagC[d]
        while (onBoard(nr2, nc2)) {
            q2 = board[squareFromRC(nr2, nc2)]
            if (q2 != EMPTY) {
                if (byWhite && q2 == BISHOP) {
                    if (pieceValue(BISHOP) < bestValue) { bestFrom = squareFromRC(nr2, nc2); bestValue = pieceValue(BISHOP) }
                } else if (!(byWhite) && q2 == 0 - BISHOP) {
                    if (pieceValue(BISHOP) < bestValue) { bestFrom = squareFromRC(nr2, nc2); bestValue = pieceValue(BISHOP) }
                } else if (byWhite && q2 == QUEEN) {
                    if (pieceValue(QUEEN) < bestValue) { bestFrom = squareFromRC(nr2, nc2); bestValue = pieceValue(QUEEN) }
                } else if (!(byWhite) && q2 == 0 - QUEEN) {
                    if (pieceValue(QUEEN) < bestValue) { bestFrom = squareFromRC(nr2, nc2); bestValue = pieceValue(QUEEN) }
                }
                break;
            }
            nr2 += diagR[d]
            nc2 += diagC[d]
        }
    }
    // Rooks / queens
    // straightR/straightC are filled once at the top of the file -- constant.
    for (let e = 0; e <= 3; e++) {
        nr3 = r2 + straightR[e]
        nc3 = c2 + straightC[e]
        while (onBoard(nr3, nc3)) {
            c = board[squareFromRC(nr3, nc3)]
            if (c != EMPTY) {
                if (byWhite && c == ROOK) {
                    if (pieceValue(ROOK) < bestValue) { bestFrom = squareFromRC(nr3, nc3); bestValue = pieceValue(ROOK) }
                } else if (!(byWhite) && c == 0 - ROOK) {
                    if (pieceValue(ROOK) < bestValue) { bestFrom = squareFromRC(nr3, nc3); bestValue = pieceValue(ROOK) }
                } else if (byWhite && c == QUEEN) {
                    if (pieceValue(QUEEN) < bestValue) { bestFrom = squareFromRC(nr3, nc3); bestValue = pieceValue(QUEEN) }
                } else if (!(byWhite) && c == 0 - QUEEN) {
                    if (pieceValue(QUEEN) < bestValue) { bestFrom = squareFromRC(nr3, nc3); bestValue = pieceValue(QUEEN) }
                }
                break;
            }
            nr3 += straightR[e]
            nc3 += straightC[e]
        }
    }
    // King
    for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
            if (dr == 0 && dc == 0) {
                continue
            }
            let nr4 = r2 + dr
            let nc4 = c2 + dc
            if (onBoard(nr4, nc4)) {
                let t = board[squareFromRC(nr4, nc4)]
                if (byWhite && t == KING) {
                    if (pieceValue(KING) < bestValue) { bestFrom = squareFromRC(nr4, nc4); bestValue = pieceValue(KING) }
                }
                if (!byWhite && t == -KING) {
                    if (pieceValue(KING) < bestValue) { bestFrom = squareFromRC(nr4, nc4); bestValue = pieceValue(KING) }
                }
            }
        }
    }
    return bestFrom
}

// Static exchange evaluation: plays out the full sequence of captures and
// recaptures on `toSq` -- starting with the move fromSq -> toSq -- on a
// disposable scratch copy of the board, and returns the net material result
// (in centipawns) for the side making that first capture. Positive means
// the exchange wins material once all forced recaptures are accounted for;
// negative means it loses material even though the first capture alone
// looks tempting (e.g. a rook "winning" a pawn that's defended by another
// pawn actually loses 400 once the rook gets recaptured).
//
// This temporarily points the global `board` at the scratch copy so it can
// reuse leastValuableAttacker's scanning logic unchanged, then restores the
// real board before returning -- the real board and search state are never
// touched.
function seeCaptureValue (fromSq: number, toSq: number) {
    let realBoardSEE = board
    board = copyBoard()

    // Reuses this ply's preallocated slot (cleared with pop(), grown only
    // with push() -- see PER-PLY REUSABLE BUFFERS) instead of a fresh
    // array every call. This is called once per candidate capture during
    // move ordering, so it can run several times per node.
    initPools()
    let gain = gainPool[searchPly]
    while (gain.length > 0) { gain.pop() }
    let d = 0
    let sideToMove = isWhite(board[fromSq])
    gain.push(pieceValue(board[toSq]))

    let currentAttackerValue = pieceValue(board[fromSq])
    board[toSq] = board[fromSq]
    board[fromSq] = EMPTY
    sideToMove = !sideToMove

    while (true) {
        let attackerFrom = leastValuableAttacker(toSq, sideToMove)
        if (attackerFrom < 0) {
            break
        }
        d = d + 1
        gain.push(currentAttackerValue - gain[d - 1])
        currentAttackerValue = pieceValue(board[attackerFrom])
        board[toSq] = board[attackerFrom]
        board[attackerFrom] = EMPTY
        sideToMove = !sideToMove
    }

    while (d > 0) {
        let optionA = 0 - gain[d - 1]
        let optionB = gain[d]
        let chosen = optionA > optionB ? optionA : optionB
        gain[d - 1] = 0 - chosen
        d = d - 1
    }

    board = realBoardSEE
    return gain[0]
}

function inCheck (white: boolean) {
    kingSquare = findKing(white)
    if (kingSquare < 0) {
        return true
    }
    return squareAttacked(kingSquare, !(white))
}

// ------------------------------------------------------------
// MOVE GENERATION
// ------------------------------------------------------------
// Writes into this ply's pool slot at pseudoMoveCount if that slot already
// exists (a plain, cheap in-bounds index assignment -- the slot is just
// left over from an earlier, possibly-longer move list at this same ply,
// and gets overwritten), and only push()es to actually grow the array
// once pseudoMoveCount reaches its current length. Before this, every
// call to generatePseudoMoves() first emptied its ply's arrays down to 0
// (via the same kind of pop() loop copyBoard()'s own comment already
// explains this file avoids for exactly this reason) and rebuilt the
// entire ~35-move list with push() from scratch -- on every single node.
// After a handful of nodes at a given ply, this pool slot has already
// grown to roughly its high-water-mark move-count, so nearly every future
// call becomes index writes only, with push() only for the rare node
// that has YET MORE moves than any earlier node at this ply.
function addMove (_from: number, to: number, promotion: number, castle: number, ep: boolean) {
    if (pseudoMoveCount < movesFrom.length) {
        movesFrom[pseudoMoveCount] = _from
        movesTo[pseudoMoveCount] = to
        movesPromotion[pseudoMoveCount] = promotion
        movesCastle[pseudoMoveCount] = castle
        movesEnPassant[pseudoMoveCount] = ep
    } else {
        movesFrom.push(_from)
        movesTo.push(to)
        movesPromotion.push(promotion)
        movesCastle.push(castle)
        movesEnPassant.push(ep)
    }
    pseudoMoveCount = pseudoMoveCount + 1
}

function generatePseudoMoves (white: boolean) {
    // Reuse this ply's preallocated move-list slot instead of allocating
    // five new arrays every call -- see PER-PLY REUSABLE BUFFERS above.
    initPools()
    movesFrom = moveFromPool[searchPly]
    movesTo = moveToPool[searchPly]
    movesPromotion = movePromotionPool[searchPly]
    movesCastle = moveCastlePool[searchPly]
    movesEnPassant = moveEPPool[searchPly]
    // Deliberately NOT emptied here -- addMove() below overwrites these
    // slots by index as it goes (see its own comment), so whatever this
    // pool slot already holds from an earlier call at this ply is just
    // stale data waiting to be overwritten or trimmed, not something that
    // needs clearing first.
    pseudoMoveCount = 0
    for (let sq2 = 0; sq2 <= 63; sq2++) {
        piece = board[sq2]
        if (piece == EMPTY) {
            continue;
        }
        if (white && piece < 0) {
            continue;
        }
        if (!(white) && piece > 0) {
            continue;
        }
        _type = Math.abs(piece)
        w = row(sq2)
        f = col(sq2)
        if (_type == PAWN) {
            let direction = white ? -1 : 1
            let startRow = white ? 6 : 1
            let promotionRow = white ? 0 : 7
            nr5 = w + direction
            if (onBoard(nr5, f)) {
                to = squareFromRC(nr5, f)
                if (board[to] == EMPTY) {
                    if (nr5 == promotionRow) {
                        addMove(sq2, to, 1, 0, false)
                    } else {
                        addMove(sq2, to, 0, 0, false)
                    }
                    if (w == startRow) {
                        nr22 = w + direction * 2
                        to2 = squareFromRC(nr22, f)
                        if (board[to2] == EMPTY) {
                            addMove(sq2, to2, 0, 0, false)
                        }
                    }
                }
            }
            for (let dc2 = -1; dc2 <= 1; dc2 += 2) {
                let nc5 = f + dc2
                let nr23 = w + direction
                if (!onBoard(nr23, nc5)) {
                    continue
                }
                let to3 = squareFromRC(nr23, nc5)
                let target = board[to3]
                if (target != EMPTY) {
                    if ((white && target < 0) || (!white && target > 0)) {
                        if (nr23 == promotionRow) {
                            addMove(sq2, to3, 1, 0, false)
                        } else {
                            addMove(sq2, to3, 0, 0, false)
                        }
                    }
                }
                if (to3 == enPassant) {
                    addMove(sq2, to3, 0, 0, true)
                }
            }
        } else if (_type == KNIGHT) {
            // knightR/knightC are the shared constant table from the top
            // of the file -- reused here instead of the old kr/kc pair
            // that rebuilt the same 8 values as a fresh array every time
            // a knight was found.
            for (let n = 0; n <= 7; n++) {
                nr6 = w + knightR[n]
                nc6 = f + knightC[n]
                if (!(onBoard(nr6, nc6))) {
                    continue;
                }
                to4 = squareFromRC(nr6, nc6)
                target2 = board[to4]
                if (target2 == EMPTY || white && target2 < 0 || !(white) && target2 > 0) {
                    addMove(sq2, to4, 0, 0, false)
                }
            }
        } else if (_type == BISHOP || _type == ROOK || _type == QUEEN) {
            // Slide along the diagonal directions (bishop/queen) and/or
            // the straight directions (rook/queen) using the SAME shared
            // diagR/diagC and straightR/straightC constant tables that
            // squareAttacked() uses, instead of assembling a fresh
            // combined direction array here every time a sliding piece
            // was found.
            if (_type == BISHOP || _type == QUEEN) {
                for (let g = 0; g <= 3; g++) {
                    nr7 = w + diagR[g]
                    nc7 = f + diagC[g]
                    while (onBoard(nr7, nc7)) {
                        to5 = squareFromRC(nr7, nc7)
                        target3 = board[to5]
                        if (target3 == EMPTY) {
                            addMove(sq2, to5, 0, 0, false)
                        } else {
                            if (white && target3 < 0 || !(white) && target3 > 0) {
                                addMove(sq2, to5, 0, 0, false)
                            }
                            break;
                        }
                        nr7 += diagR[g]
                        nc7 += diagC[g]
                    }
                }
            }
            if (_type == ROOK || _type == QUEEN) {
                for (let g2 = 0; g2 <= 3; g2++) {
                    nr7 = w + straightR[g2]
                    nc7 = f + straightC[g2]
                    while (onBoard(nr7, nc7)) {
                        to5 = squareFromRC(nr7, nc7)
                        target3 = board[to5]
                        if (target3 == EMPTY) {
                            addMove(sq2, to5, 0, 0, false)
                        } else {
                            if (white && target3 < 0 || !(white) && target3 > 0) {
                                addMove(sq2, to5, 0, 0, false)
                            }
                            break;
                        }
                        nr7 += straightR[g2]
                        nc7 += straightC[g2]
                    }
                }
            }
        } else if (_type == KING) {
            for (let dr2 = -1; dr2 <= 1; dr2++) {
                for (let dc3 = -1; dc3 <= 1; dc3++) {
                    if (dr2 == 0 && dc3 == 0) {
                        continue
                    }
                    let nr8 = w + dr2
                    let nc8 = f + dc3
                    if (!onBoard(nr8, nc8)) {
                        continue
                    }
                    let to6 = squareFromRC(nr8, nc8)
                    let target4 = board[to6]
                    if (target4 == EMPTY ||
                        (white && target4 < 0) ||
                        (!white && target4 > 0)) {
                        addMove(sq2, to6, 0, 0, false)
                    }
                }
            }
            // CASTLING
            if (white && sq2 == 60 && !(inCheck(true))) {
                if (whiteCastleKing && board[61] == EMPTY && board[62] == EMPTY && !(squareAttacked(61, false)) && !(squareAttacked(62, false))) {
                    addMove(60, 62, 0, 1, false)
                }
                if (whiteCastleQueen && board[59] == EMPTY && board[58] == EMPTY && board[57] == EMPTY && !(squareAttacked(59, false)) && !(squareAttacked(58, false))) {
                    addMove(60, 58, 0, 2, false)
                }
            }
            if (!(white) && sq2 == 4 && !(inCheck(false))) {
                if (blackCastleKing && board[5] == EMPTY && board[6] == EMPTY && !(squareAttacked(5, true)) && !(squareAttacked(6, true))) {
                    addMove(4, 6, 0, 1, false)
                }
                if (blackCastleQueen && board[3] == EMPTY && board[2] == EMPTY && board[1] == EMPTY && !(squareAttacked(3, true)) && !(squareAttacked(2, true))) {
                    addMove(4, 2, 0, 2, false)
                }
            }
        }
    }
    // Trim any stale tail left over from an earlier, longer move list at
    // this same ply -- addMove() only ever overwrote or grew, it never
    // shrinks, so without this the arrays could still be longer than
    // pseudoMoveCount actual moves.
    while (movesFrom.length > pseudoMoveCount) { movesFrom.pop() }
    while (movesTo.length > pseudoMoveCount) { movesTo.pop() }
    while (movesPromotion.length > pseudoMoveCount) { movesPromotion.pop() }
    while (movesCastle.length > pseudoMoveCount) { movesCastle.pop() }
    while (movesEnPassant.length > pseudoMoveCount) { movesEnPassant.pop() }
}

function testMoveLegal (index: number) {
    savedTurn = whiteToMove
    savedWCK = whiteCastleKing
    savedWCQ = whiteCastleQueen
    savedBCK = blackCastleKing
    savedBCQ = blackCastleQueen
    savedEP = enPassant
    movingWhite = whiteToMove
    let savedWHC = whiteHasCastled
    let savedBHC = blackHasCastled
    // Captured before makeMove() so this doesn't rely on movesFrom/etc.
    // still pointing at the same array afterward -- inCheck() below never
    // touches them, but capturing up front costs nothing and matches the
    // rule every other call site follows.
    let uFromTML = movesFrom[index]
    let uToTML = movesTo[index]
    let uPromotionTML = movesPromotion[index]
    let uCastleTML = movesCastle[index]
    let uEPTML = movesEnPassant[index]
    makeMove(index)
    let savedCapturedTML = captured
    legal = !(inCheck(movingWhite))
    unmakeMove(uFromTML, uToTML, uPromotionTML, uCastleTML, uEPTML, savedCapturedTML)
    whiteToMove = savedTurn
    whiteCastleKing = savedWCK
    whiteCastleQueen = savedWCQ
    blackCastleKing = savedBCK
    blackCastleQueen = savedBCQ
    enPassant = savedEP
    whiteHasCastled = savedWHC
    blackHasCastled = savedBHC
    return legal
}

function generateLegalMoves (white: boolean) {
    // Filters the pseudo-legal list down to legal moves IN PLACE (compact
    // survivors toward the front, then truncate) instead of building a
    // second set of five new arrays -- testMoveLegal() only ever reads
    // the single index it's given, never scans the rest of the list, so
    // it's always safe to overwrite an earlier, already-processed slot.
    generatePseudoMoves(white)
    count = movesFrom.length

    // FAST-PATH LEGALITY CHECK: testMoveLegal() is expensive -- a full
    // board copy, make the move, scan the whole board for an attacker,
    // then copy the board back -- and naively calling it for every single
    // pseudo-legal move (~35 of them in a typical middlegame position) was
    // by far the biggest cost per search node.
    //
    // The only way moving a piece can expose your own king to check is if
    // that piece sits on the same rank, file or diagonal as your king AND
    // there's an enemy slider aimed down that line (a "pin") -- so a piece
    // that ISN'T on any of those three lines through the king can NEVER be
    // pinned, and moving it is automatically legal whenever the king isn't
    // currently in check. We don't even bother confirming there's really a
    // pinning slider there; "shares a line with the king" is a safe (if
    // slightly conservative) superset of "is pinned", so this can only
    // ever skip the full test on moves that are genuinely always legal --
    // it can never wrongly skip one that needed checking.
    // King moves, en-passant captures, and anything while already in check
    // still always go through the full, definitely-correct test below:
    // king moves can walk into a new check the pin logic above doesn't
    // cover, en-passant has its own rare discovered-check edge case along
    // the rank, and while in check the legality of every move depends on
    // whether it actually addresses that check, which this shortcut
    // doesn't reason about at all.
    legalGenKingSquare = findKing(white)
    legalGenInCheck = legalGenKingSquare < 0 ? true : squareAttacked(legalGenKingSquare, !white)
    let legalGenKingRow = legalGenKingSquare >= 0 ? row(legalGenKingSquare) : -1
    let legalGenKingCol = legalGenKingSquare >= 0 ? col(legalGenKingSquare) : -1

    let writeIdx = 0
    for (let v = 0; v <= count - 1; v++) {
        let needsFullTest = true
        if (!legalGenInCheck && legalGenKingSquare >= 0 && movesFrom[v] != legalGenKingSquare && !movesEnPassant[v]) {
            let fromRow = row(movesFrom[v])
            let fromCol = col(movesFrom[v])
            let sharesKingLine = (fromRow == legalGenKingRow) || (fromCol == legalGenKingCol) || (Math.abs(fromRow - legalGenKingRow) == Math.abs(fromCol - legalGenKingCol))
            if (!sharesKingLine) {
                needsFullTest = false
            }
        }
        let moveIsLegal = needsFullTest ? testMoveLegal(v) : true
        if (moveIsLegal) {
            if (writeIdx != v) {
                movesFrom[writeIdx] = movesFrom[v]
                movesTo[writeIdx] = movesTo[v]
                movesPromotion[writeIdx] = movesPromotion[v]
                movesCastle[writeIdx] = movesCastle[v]
                movesEnPassant[writeIdx] = movesEnPassant[v]
            }
            writeIdx = writeIdx + 1
        }
    }
    // Same reasoning as generatePseudoMoves above: trim with pop() in a
    // loop, never "arr.length = writeIdx" (unsupported on-device).
    while (movesFrom.length > writeIdx) { movesFrom.pop() }
    while (movesTo.length > writeIdx) { movesTo.pop() }
    while (movesPromotion.length > writeIdx) { movesPromotion.pop() }
    while (movesCastle.length > writeIdx) { movesCastle.pop() }
    while (movesEnPassant.length > writeIdx) { movesEnPassant.pop() }
}

// ------------------------------------------------------------
// MAKE MOVE
// ------------------------------------------------------------
function makeMove (index: number) {
    _from = movesFrom[index]
    to7 = movesTo[index]
    piece2 = board[_from]
    captured = board[to7]
    // En-passant capture
    if (movesEnPassant[index]) {
        if (piece2 > 0) {
            board[to7 + 8] = EMPTY
        } else {
            board[to7 - 8] = EMPTY
        }
    }
    board[to7] = piece2
    board[_from] = EMPTY
    // Promotion
    if (movesPromotion[index] != 0) {
        if (piece2 > 0) {
            board[to7] = QUEEN
        } else {
            board[to7] = 0 - QUEEN
        }
    }
    // Castling: move rook
    if (movesCastle[index] == 1) {
        if (piece2 > 0) {
            board[63] = EMPTY
            board[61] = ROOK
            whiteHasCastled = true
        } else {
            board[7] = EMPTY
            board[5] = 0 - ROOK
            blackHasCastled = true
        }
    } else if (movesCastle[index] == 2) {
        if (piece2 > 0) {
            board[56] = EMPTY
            board[59] = ROOK
            whiteHasCastled = true
        } else {
            board[0] = EMPTY
            board[3] = 0 - ROOK
            blackHasCastled = true
        }
    }
    // Update castling rights
    if (piece2 == KING) {
        whiteCastleKing = false
        whiteCastleQueen = false
    }
    if (piece2 == 0 - KING) {
        blackCastleKing = false
        blackCastleQueen = false
    }
    if (_from == 63 || to7 == 63) {
        whiteCastleKing = false
    }
    if (_from == 56 || to7 == 56) {
        whiteCastleQueen = false
    }
    if (_from == 7 || to7 == 7) {
        blackCastleKing = false
    }
    if (_from == 0 || to7 == 0) {
        blackCastleQueen = false
    }
    // New en-passant target
    enPassant = -1
    if (Math.abs(piece2) == PAWN) {
        if (Math.abs(to7 - _from) == 16) {
            enPassant = (to7 + _from) / 2
        }
    }
    whiteToMove = !(whiteToMove)
    return captured != EMPTY
}

// Reverses exactly what makeMove(index) did to the BOARD ARRAY ONLY --
// putting back only the 2-4 squares that move actually touched, instead of
// the old approach every call site used to use (copyBoard() a full 64-slot
// snapshot before the move, restoreBoard() it back after). Every call site
// already saves and restores whiteToMove/castling rights/en passant/
// whiteHasCastled/blackHasCastled itself via plain local variables (that
// was never the expensive part) -- this only replaces the board-copying
// half of that pattern.
//
// `capturedPiece` has to be handed in by the caller: it's whatever the
// makeMove() call's own `captured` GLOBAL held right after that call, and
// since `captured` is a single shared global (like piece2/_from/to7
// above), a caller MUST read it into a local variable immediately after
// calling makeMove() and before making any further recursive call -- a
// nested makeMove() from deeper in the search would otherwise silently
// overwrite it before this unmake ever runs. This is exactly the same
// "don't let a shared global survive across a recursive call" rule this
// file already follows for every other piece of per-move state.
// Takes the move's own details as plain parameters rather than an index
// into movesFrom/movesTo/movesPromotion/movesCastle/movesEnPassant. Those
// arrays are shared globals that a nested recursive call (which runs
// generateLegalMoves() and reassigns them to a DIFFERENT ply's arrays) is
// guaranteed to have repointed by the time control gets back here to undo
// this move -- reading `movesFrom[index]` etc. at this point would silently
// read the wrong ply's move list. So the caller captures everything this
// needs into its own local variables right after calling makeMove(index),
// before any recursive call has a chance to touch those globals, exactly
// the same discipline already used for `captured`.
function unmakeMove (uFrom: number, uTo: number, uPromotion: number, uCastle: number, uEnPassant: boolean, capturedPiece: number): void {
    let movedPiece = board[uTo]
    if (uPromotion != 0) {
        // Whatever is sitting on the destination square right now is the
        // promoted piece (always a queen, per addMove's promotion flag) --
        // the piece that actually left `from` was a pawn of the same color.
        movedPiece = movedPiece > 0 ? PAWN : 0 - PAWN
    }
    board[uFrom] = movedPiece
    board[uTo] = capturedPiece
    if (uEnPassant) {
        // The captured pawn was never actually ON the `to` square (that's
        // why en passant needs its own case) -- makeMove() put EMPTY there
        // and removed the real captured pawn from the square behind it.
        board[uTo] = EMPTY
        if (movedPiece > 0) {
            board[uTo + 8] = 0 - PAWN
        } else {
            board[uTo - 8] = PAWN
        }
    }
    if (uCastle == 1) {
        if (movedPiece > 0) {
            board[61] = EMPTY
            board[63] = ROOK
        } else {
            board[5] = EMPTY
            board[7] = 0 - ROOK
        }
    } else if (uCastle == 2) {
        if (movedPiece > 0) {
            board[59] = EMPTY
            board[56] = ROOK
        } else {
            board[3] = EMPTY
            board[0] = 0 - ROOK
        }
    }
}

// ------------------------------------------------------------
// PIECE-SQUARE TABLES
// Standard "simplified evaluation function" tables (values in
// centipawns). Index 0 = a8 ... index 63 = h1, same convention
// as the board array, so a White piece's table value can be
// looked up directly by its square index. For a Black piece,
// the table is looked up mirrored top-to-bottom (its good
// squares are the mirror image of White's) and the result is
// then negated before adding to the score, since positive score
// always means "good for White" throughout evaluate().
// ------------------------------------------------------------
