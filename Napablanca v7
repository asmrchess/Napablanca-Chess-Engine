// ------------------------------------------------------------
// THREEFOLD REPETITION
//
// positionHistory holds a key for every position reached in the REAL
// game so far (not hypothetical search moves). It's cleared every time
// a capture or pawn move happens, because after an irreversible move
// like that the exact earlier position can never occur again -- so
// there's no need to keep comparing against it, which also keeps this
// list (and the repetition check) cheap even in a long game.
// ------------------------------------------------------------
let positionHistory: number[] = []

// A key that identifies "the position" for repetition purposes: the
// board, whose turn it is, and castling rights, folded into a single
// number via a simple polynomial rolling hash instead of a concatenated
// string. This is called on every move tried anywhere in the search tree
// (not just once per node), and the old string-building version did 64+
// string concatenations -- each one a fresh heap allocation -- every
// single time. That was almost certainly the single biggest source of
// the allocation churn behind the "out of memory" panic: worse than the
// move-list/board-copy churn the per-ply pools above fix, because it ran
// even more often. A numeric hash does the same 64-square scan but with
// plain arithmetic, no allocation at all. Collisions are astronomically
// unlikely here (a 32-bit hash space against the handful of positions
// ever compared in a repetition window at once) and this is only used
// for repetition/contempt heuristics, never for move legality, so the
// negligible remaining risk isn't safety-critical.
function positionKey (): number {
    let key = 0
    for (let z = 0; z <= 63; z++) {
        key = (key * 33 + board[z] + 8) | 0
    }
    key = (key * 33 + (whiteToMove ? 1 : 0)) | 0
    key = (key * 33 + (whiteCastleKing ? 1 : 0)) | 0
    key = (key * 33 + (whiteCastleQueen ? 1 : 0)) | 0
    key = (key * 33 + (blackCastleKing ? 1 : 0)) | 0
    key = (key * 33 + (blackCastleQueen ? 1 : 0)) | 0
    return key
}

// Call right after making a REAL move (not a hypothetical search move).
// `irreversible` should be true if that move was a capture or a pawn
// move -- pass (captured != EMPTY) || (Math.abs(piece2) == PAWN), read
// right after makeMove() sets those two scratch variables as a side
// effect of making the move.
function recordPosition (irreversible: boolean): void {
    if (irreversible) {
        positionHistory = []
    }
    positionHistory.push(positionKey())
}

function countRepetitions (key: number): number {
    let cnt = 0
    for (let z2 = 0; z2 <= positionHistory.length - 1; z2++) {
        if (positionHistory[z2] == key) {
            cnt = cnt + 1
        }
    }
    return cnt
}

function playMove (fromName: string, toName: string) {
    from2 = squareFromName(fromName)
    to8 = squareFromName(toName)
    if (from2 < 0 || to8 < 0) {
        return false
    }
    generateLegalMoves(whiteToMove)
    for (let i5 = 0; i5 <= movesFrom.length - 1; i5++) {
        if (movesFrom[i5] == from2 && movesTo[i5] == to8) {
            makeMove(i5)
            recordPosition((captured != EMPTY) || (Math.abs(piece2) == PAWN))
            return true
        }
    }
    return false
}

function resetBoard () {
    initPools()
    board = []
    for (let index = 0; index < 64; index++) {
        board.push(EMPTY)
    }
    // Black pieces
    board[0] = 0 - ROOK
    board[1] = 0 - KNIGHT
    board[2] = 0 - BISHOP
    board[3] = 0 - QUEEN
    board[4] = 0 - KING
    board[5] = 0 - BISHOP
    board[6] = 0 - KNIGHT
    board[7] = 0 - ROOK
    for (let s = 8; s < 16; s++) {
        board[s] = -PAWN
    }
    // White pieces
    board[56] = ROOK
    board[57] = KNIGHT
    board[58] = BISHOP
    board[59] = QUEEN
    board[60] = KING
    board[61] = BISHOP
    board[62] = KNIGHT
    board[63] = ROOK
    for (let u = 48; u < 56; u++) {
        board[u] = PAWN
    }
    whiteToMove = true
    whiteCastleKing = true
    whiteCastleQueen = true
    blackCastleKing = true
    blackCastleQueen = true
    whiteHasCastled = false
    blackHasCastled = false
    // En-passant target square. -1 means there isn't one.
    enPassant = -1
    positionHistory = []
    positionHistory.push(positionKey())
    resetSearchMemory()
}

