// Looks up a piece-square table value for a piece on square `sq`.
// White pieces read the table directly; Black pieces read it
// mirrored top-to-bottom (their promotion rank is rank 1's mirror
// of White's rank 8, etc).
function pstLookup (table: number[], sq: number, white: boolean): number {
    if (white) {
        return table[sq]
    } else {
        let mirrored = squareFromRC(7 - row(sq), col(sq))
        return table[mirrored]
    }
}

// A pawn is "passed" if no enemy pawn can ever stop or capture it on its
// way to promotion -- that is, no enemy pawn sits on its own file or
// either adjacent file, anywhere between it and the promotion rank.
function isPassedPawn (sq: number, white: boolean) {
    let pr = row(sq)
    let pc = col(sq)
    for (let cf = pc - 1; cf <= pc + 1; cf++) {
        if (cf < 0 || cf > 7) {
            continue;
        }
        if (white) {
            for (let rr = 0; rr < pr; rr++) {
                if (board[squareFromRC(rr, cf)] == 0 - PAWN) {
                    return false
                }
            }
        } else {
            for (let rr = pr + 1; rr <= 7; rr++) {
                if (board[squareFromRC(rr, cf)] == PAWN) {
                    return false
                }
            }
        }
    }
    return true
}

// ------------------------------------------------------------
// EVALUATION
// ------------------------------------------------------------
function evaluate () {
    score = 0
    // 1. MATERIAL
    for (let i = 0; i <= 63; i++) {
        p = board[i]
        if (p == EMPTY) {
            continue;
        }
        value = pieceValue(p)
        if (isWhite(p)) {
            score += value
        } else {
            score += 0 - value
        }
    }
    // 2. PIECE-SQUARE TABLES -- per-piece-type positional bonuses
    //    (centre control, development and king safety all fall out of
    //    these automatically, more precisely than ad-hoc bonuses did).
    //    The king table switches to an endgame version once there isn't
    //    much material left on the board.
    let nonPawnMaterial = 0
    for (let ii = 0; ii <= 63; ii++) {
        let ppNP = board[ii]
        if (ppNP == EMPTY) {
            continue;
        }
        let atNP = Math.abs(ppNP)
        if (atNP != PAWN && atNP != KING) {
            nonPawnMaterial += pieceValue(ppNP)
        }
    }
    let isEndgame = nonPawnMaterial <= 1300

    for (let i3 = 0; i3 <= 63; i3++) {
        let pc = board[i3]
        if (pc == EMPTY) {
            continue;
        }
        let whiteSide = pc > 0
        let atype = Math.abs(pc)
        let pstVal = 0
        if (atype == PAWN) {
            pstVal = pstLookup(PST_PAWN, i3, whiteSide)
        } else if (atype == KNIGHT) {
            pstVal = pstLookup(PST_KNIGHT, i3, whiteSide)
        } else if (atype == BISHOP) {
            pstVal = pstLookup(PST_BISHOP, i3, whiteSide)
        } else if (atype == ROOK) {
            pstVal = pstLookup(PST_ROOK, i3, whiteSide)
        } else if (atype == QUEEN) {
            pstVal = pstLookup(PST_QUEEN, i3, whiteSide)
        } else if (atype == KING) {
            if (isEndgame) {
                pstVal = pstLookup(PST_KING_END, i3, whiteSide)
            } else {
                pstVal = pstLookup(PST_KING_MID, i3, whiteSide)
            }
        }
        if (whiteSide) {
            score += pstVal
        } else {
            score += 0 - pstVal
        }
    }
    // 3. THREATS -- being attacked is bad for the piece's own side,
    //    threatening an enemy piece is good for the attacker
    //
    //    This used to call squareAttacked(k, ...) fresh for every one of
    //    the up to ~30 occupied squares -- each call its own full scan
    //    outward from that square. buildAttackMap() computes the exact
    //    same true/false answers for all 64 squares at once, in one pass
    //    over the board's pieces, so this loop is now just two O(1) array
    //    lookups per piece instead of two full board scans.
    buildAttackMap(false, attackMapBlack)
    buildAttackMap(true, attackMapWhite)
    for (let k = 0; k <= 63; k++) {
        r = board[k]
        if (r == EMPTY) {
            continue;
        }
        // White piece -- being attacked by Black is BAD for White
        if (r > 0) {
            if (attackMapBlack[k]) {
                score += 0 - 5
                if (r == QUEEN) {
                    score += 0 - 20
                } else if (r == ROOK) {
                    score += 0 - 12
                } else if (r == BISHOP || r == KNIGHT) {
                    score += 0 - 8
                }
            }
        }
        // Black piece -- being attacked by White is GOOD for White
        if (r < 0) {
            if (attackMapWhite[k]) {
                score += 5
                if (r == 0 - QUEEN) {
                    score += 20
                } else if (r == 0 - ROOK) {
                    score += 12
                } else if (r == 0 - BISHOP || r == 0 - KNIGHT) {
                    score += 8
                }
            }
        }
    }
    // 4. CASTLING -- reward ACTUALLY castling; mildly penalize losing
    //    castling rights without having castled (a manual king/rook move)
    if (!(whiteCastleKing) && !(whiteCastleQueen)) {
        if (whiteHasCastled) {
            score += 40
        } else {
            score += 0 - 15
        }
    }
    if (!(blackCastleKing) && !(blackCastleQueen)) {
        if (blackHasCastled) {
            score += 0 - 40
        } else {
            score += 15
        }
    }

    // 5. PAWN STRUCTURE, BISHOP PAIR, ROOK/KING FILE SAFETY
    //    One pass builds per-file pawn counts for both sides; doubled,
    //    isolated and the rook/king open-file checks below all reuse it
    //    (an "open" file has no pawns of either color; a "semi-open" file
    //    has none of the side being checked, but the other side still has
    //    one there).
    // whitePawnsOnFile/blackPawnsOnFile and passedBonusByDistance are
    // shared globals declared near the top of the file now, reset (not
    // reallocated) below -- see the note there.
    for (let pfc = 0; pfc <= 7; pfc++) {
        whitePawnsOnFile[pfc] = 0
        blackPawnsOnFile[pfc] = 0
    }
    for (let pf = 0; pf <= 63; pf++) {
        let pcf = board[pf]
        if (pcf == PAWN) {
            whitePawnsOnFile[col(pf)] = whitePawnsOnFile[col(pf)] + 1
        } else if (pcf == 0 - PAWN) {
            blackPawnsOnFile[col(pf)] = blackPawnsOnFile[col(pf)] + 1
        }
    }

    let whiteBishops = 0
    let blackBishops = 0

    for (let pf2 = 0; pf2 <= 63; pf2++) {
        let pcf2 = board[pf2]
        if (pcf2 == EMPTY) {
            continue;
        }
        let fcol = col(pf2)

        if (pcf2 == BISHOP) { whiteBishops = whiteBishops + 1 }
        if (pcf2 == 0 - BISHOP) { blackBishops = blackBishops + 1 }

        if (pcf2 == PAWN) {
            if (whitePawnsOnFile[fcol] > 1) { score += 0 - 12 }
            let hasNeighborW = false
            if (fcol > 0 && whitePawnsOnFile[fcol - 1] > 0) { hasNeighborW = true }
            if (fcol < 7 && whitePawnsOnFile[fcol + 1] > 0) { hasNeighborW = true }
            if (!hasNeighborW) { score += 0 - 14 }
            if (isPassedPawn(pf2, true)) {
                let distW = row(pf2)
                score += passedBonusByDistance[distW]
            }
        } else if (pcf2 == 0 - PAWN) {
            if (blackPawnsOnFile[fcol] > 1) { score += 12 }
            let hasNeighborB = false
            if (fcol > 0 && blackPawnsOnFile[fcol - 1] > 0) { hasNeighborB = true }
            if (fcol < 7 && blackPawnsOnFile[fcol + 1] > 0) { hasNeighborB = true }
            if (!hasNeighborB) { score += 14 }
            if (isPassedPawn(pf2, false)) {
                let distB = 7 - row(pf2)
                score += 0 - passedBonusByDistance[distB]
            }
        } else if (pcf2 == ROOK) {
            if (whitePawnsOnFile[fcol] == 0) {
                score += blackPawnsOnFile[fcol] == 0 ? 15 : 8
            }
        } else if (pcf2 == 0 - ROOK) {
            if (blackPawnsOnFile[fcol] == 0) {
                score += whitePawnsOnFile[fcol] == 0 ? -15 : -8
            }
        } else if (pcf2 == KING) {
            if (whitePawnsOnFile[fcol] == 0) {
                score += blackPawnsOnFile[fcol] == 0 ? -25 : -12
            }
        } else if (pcf2 == 0 - KING) {
            if (blackPawnsOnFile[fcol] == 0) {
                score += whitePawnsOnFile[fcol] == 0 ? 25 : 12
            }
        }
    }
    if (whiteBishops >= 2) { score += 30 }
    if (blackBishops >= 2) { score += 0 - 30 }

    return score
}

// ------------------------------------------------------------
// MOVE ORDERING
// ------------------------------------------------------------
function orderMoveIndices (depthRemaining: number, useRootPV: boolean): number[] {
    // Reuses this ply's preallocated slot instead of allocating two new
    // arrays every node -- same PER-PLY REUSABLE BUFFERS pattern as move
    // generation and board copies. This runs once per search/quiesce
    // node (not once per move tried), but that's still every node in the
    // whole tree, so it mattered just as much as the move lists did.
    initPools()
    let order = orderPool[searchPly]
    let tacticalValue = tacticalValuePool[searchPly]
    while (order.length > 0) { order.pop() }
    while (tacticalValue.length > 0) { tacticalValue.pop() }
    for (let i = 0; i <= movesFrom.length - 1; i++) {
        order.push(i)
        let v = 0
        let targetPiece = board[movesTo[i]]
        let isCaptureMove = targetPiece != EMPTY
        if (isCaptureMove) {
            // Order captures by their STATIC EXCHANGE EVALUATION (the net
            // material result once every forced recapture on that square
            // is played out), not just the victim's raw value -- a queen
            // "winning" a pawn that's defended by another pawn is actually
            // a bad trade once the recapture happens, and SEE knows that
            // where plain MVV-LVA didn't.
            let seeVal = seeCaptureValue(movesFrom[i], movesTo[i])
            v = v + 20000 + seeVal
        }
        if (movesPromotion[i] != 0) {
            v = v + 800
        }
        if (!isCaptureMove && movesPromotion[i] == 0) {
            // Quiet move: killer moves (refutations found elsewhere at this
            // same depth) first, then the history heuristic (how often this
            // exact [from,to] move has caused a cutoff anywhere so far).
            if (depthRemaining >= 0 && depthRemaining < KILLER_SLOTS) {
                if (movesFrom[i] == killerFrom1[depthRemaining] && movesTo[i] == killerTo1[depthRemaining]) {
                    v = v + 6000
                } else if (movesFrom[i] == killerFrom2[depthRemaining] && movesTo[i] == killerTo2[depthRemaining]) {
                    v = v + 5000
                }
            }
            let histPieceType = Math.abs(board[movesFrom[i]])
            let histVal = historyTable[(histPieceType - 1) * 64 + movesTo[i]]
            if (histVal > 4000) { histVal = 4000 }
            v = v + histVal
        }
        if (useRootPV) {
            if (movesFrom[i] == rootPVFrom && movesTo[i] == rootPVTo) {
                v = v + 1000000
            }
        }
        tacticalValue.push(v)
    }
    for (let x = 1; x <= order.length - 1; x++) {
        let keyOrder = order[x]
        let keyVal = tacticalValue[x]
        let y = x - 1
        while (y >= 0 && tacticalValue[y] < keyVal) {
            order[y + 1] = order[y]
            tacticalValue[y + 1] = tacticalValue[y]
            y = y - 1
        }
        order[y + 1] = keyOrder
        tacticalValue[y + 1] = keyVal
    }
    return order
}

// DIAGNOSTIC TOGGLE: the "thinking" LED animation (updateThinkingAnimation,
// below) is the ONE thing that runs during a timed search and never runs
// during a fixed-ply search -- so it's the prime suspect for why timed
// searches have been reaching much shallower depths than a fixed-ply search
// of the same position does in the same rough amount of time. Flip this to
// false, reflash, and re-run the same timed test: if the depth reached
// jumps back up to what the node-count math predicts, this confirms the
// animation (or something in the display calls it makes) is the bottleneck,
// and we can look at making it cheaper rather than guessing further.
let ENABLE_THINKING_ANIMATION = true

// ------------------------------------------------------------
// QUIESCENCE SEARCH
// ------------------------------------------------------------

function quiesce (alpha: number, beta: number): number {
    let nowT = input.runningTime()
    if (animationEnabled) {
        debugNodeCount = debugNodeCount + 1
        updateDebugCounter(nowT)
    }
    if (nowT > searchDeadline) {
        searchAborted = true
        return 0
    }
    if (animationEnabled && ENABLE_THINKING_ANIMATION) {
        updateThinkingAnimation(nowT)
    }
    let standPat = evaluate()
    let maximizing = whiteToMove
    if (maximizing) {
        if (standPat >= beta) { return beta }
        if (standPat > alpha) { alpha = standPat }
    } else {
        if (standPat <= alpha) { return alpha }
        if (standPat < beta) { beta = standPat }
    }

    generateLegalMoves(whiteToMove)
    if (movesFrom.length == 0) {
        // Same reuse as in search() -- generateLegalMoves() already worked
        // this out.
        if (legalGenInCheck) {
            return maximizing ? -29000 : 29000
        }
        return 0
    }

    let localFrom = movesFrom
    let localTo = movesTo
    let localPromotion = movesPromotion
    let localCastle = movesCastle
    let localEP = movesEnPassant
    let order = orderMoveIndices(-1, false)
    // orderMoveIndices() already ran seeCaptureValue() on every capture here
    // to sort them -- this pool slot (captured now, same per-ply-reuse
    // reasoning as localFrom/etc. above) still holds each move's ordering
    // score at the matching index into `order`, so SEE pruning below can
    // read the SEE value back out of it instead of paying for a second,
    // redundant seeCaptureValue() call on every capture tried.
    let localTacticalValue = tacticalValuePool[searchPly]

    for (let k = 0; k <= order.length - 1; k++) {
        let idx = order[k]
        let isCaptureMove = board[localTo[idx]] != EMPTY
        let isTactical = isCaptureMove || (localPromotion[idx] != 0)
        if (!isTactical) { break }

        // SEE PRUNING: skip a capture that loses material even after every
        // forced recapture plays out -- quiescence exists to resolve
        // tactics, and a capture that comes out behind on the exchange
        // isn't one. Captures are tried in SEE order, best first (see
        // orderMoveIndices), so a losing one here doesn't mean a later,
        // better capture gets skipped too -- only `continue`s past this
        // one loser, rather than `break`ing the whole loop, since a
        // non-capturing promotion (no exchange to evaluate, so not
        // SEE-pruned) can still be waiting later in this same list.
        // seeVal recovered from orderMoveIndices()'s own scoring formula
        // (v = 20000 + seeVal, plus 800 more if this capture is also a
        // promotion) rather than recomputed from scratch.
        if (isCaptureMove) {
            let seeVal = localTacticalValue[k] - 20000 - (localPromotion[idx] != 0 ? 800 : 0)
            if (seeVal < 0) { continue }
        }

        movesFrom = localFrom; movesTo = localTo; movesPromotion = localPromotion
        movesCastle = localCastle; movesEnPassant = localEP

        let sTurn = whiteToMove
        let sWCK = whiteCastleKing
        let sWCQ = whiteCastleQueen
        let sBCK = blackCastleKing
        let sBCQ = blackCastleQueen
        let sEP = enPassant
        let sWHC = whiteHasCastled
        let sBHC = blackHasCastled

        makeMove(idx)
        let sCaptured = captured
        let s = 0
        if (searchPly + 1 >= MAX_PLY) {
            // Safety net against a pathological, unrealistically long
            // forced-capture chain running past the pool size -- just
            // stop extending and settle for the static eval here.
            s = evaluate()
        } else {
            searchPly = searchPly + 1
            s = quiesce(alpha, beta)
            searchPly = searchPly - 1
        }

        // localFrom/localTo/etc. (captured before this loop started) are
        // used here instead of movesFrom[idx]/movesTo[idx] -- the recursive
        // quiesce() call just above reassigned those globals to a deeper
        // ply's arrays, so reading them now would read the wrong move.
        unmakeMove(localFrom[idx], localTo[idx], localPromotion[idx], localCastle[idx], localEP[idx], sCaptured); whiteToMove = sTurn
        whiteCastleKing = sWCK; whiteCastleQueen = sWCQ
        blackCastleKing = sBCK; blackCastleQueen = sBCQ
        enPassant = sEP
        whiteHasCastled = sWHC
        blackHasCastled = sBHC

        if (searchAborted) { break }

        if (maximizing) {
            if (s > alpha) { alpha = s }
        } else {
            if (s < beta) { beta = s }
        }
        if (alpha >= beta) { break }
    }
    return maximizing ? alpha : beta
}

// Lights up more of the 5x5 LED grid as the current move's time budget
// runs out (25 LEDs total, filled in a snaking order). Only does anything
// while animationEnabled is true (set by findBestMoveTimed), and is
// throttled to update at most every 200ms so it doesn't slow the search.
function updateThinkingAnimation (now: number): void {
    if (now - lastLedUpdateTime < 200) {
        return
    }
    lastLedUpdateTime = now
    let fraction = 1
    if (searchBudgetMillis > 0) {
        fraction = (now - searchStartTime) / searchBudgetMillis
    }
    if (fraction < 0) { fraction = 0 }
    if (fraction > 1) { fraction = 1 }
    let count = Math.floor(fraction * 25)
    if (count < 1) { count = 1 }
    if (count > 25) { count = 25 }
    if (count == lastLedCount) {
        return
    }
    lastLedCount = count
    basic.clearScreen()
    for (let i = 0; i <= count - 1; i++) {
        led.plot(ledOrderX[i], ledOrderY[i])
    }
}

// ------------------------------------------------------------
// SEARCH (alpha-beta with move ordering, quiescence at horizon)
// ------------------------------------------------------------
// NOTE: an earlier version of this function had null-move pruning added
// here. It was removed after testing found it caused real blunders (e.g.
// missing a simple free-pawn capture in the opening) -- raising its
// minimum-depth guard only pushed the same failure one ply deeper rather
// than fixing it, so rather than ship something that plays worse in
// ordinary positions, it was taken back out. Everything else from that
// round of changes (piece-square tables, MVV-LVA move ordering, the
// instant single-legal-move path) tested correctly and stayed.
function search (depth: number, alpha: number, beta: number, extCount: number): number {
    let nowT = input.runningTime()
    if (animationEnabled) {
        debugNodeCount = debugNodeCount + 1
        updateDebugCounter(nowT)
    }
    if (nowT > searchDeadline) {
        searchAborted = true
        return 0
    }
    if (animationEnabled && ENABLE_THINKING_ANIMATION) {
        updateThinkingAnimation(nowT)
    }
    generateLegalMoves(whiteToMove)
    // generateLegalMoves() just computed exactly this (as legalGenInCheck)
    // while it was already scanning for the king anyway -- no need to pay
    // for a second full findKing()+squareAttacked() scan to ask the same
    // question again.
    let nodeInCheck = legalGenInCheck
    if (movesFrom.length == 0) {
        if (nodeInCheck) {
            if (whiteToMove) { return -30000 - depth }
            else { return 30000 + depth }
        } else { return 0 }
    }

    // CHECK EXTENSION: being in check right now means there are few legal
    // replies and a forced tactic could be just past the horizon, so give
    // this node an extra ply "for free" (without spending the normal depth
    // budget) rather than risk cutting the line off mid-check. Capped by
    // MAX_CHECK_EXTENSIONS per line so a long sequence of checks can't blow
    // up the time budget.
    let effectiveDepth = depth
    let nextExtCount = extCount
    if (nodeInCheck && extCount < MAX_CHECK_EXTENSIONS) {
        effectiveDepth = depth + 1
        nextExtCount = extCount + 1
    }

    // THREEFOLD REPETITION (within the search tree): if the position we
    // just arrived at has now happened 3 times (counting the real game's
    // history plus hypothetical moves made so far along this search
    // line), it's a forced draw -- no need to search deeper here. Apply
    // a small contempt adjustment so the engine is mildly reluctant to
    // walk into this when it's clearly ahead, and mildly willing to when
    // it's clearly behind (a draw is a good result if you're losing).
    if (searchPathKeys.length > 0) {
        let curKey = searchPathKeys[searchPathKeys.length - 1]
        let repCount = 0
        for (let z4 = searchIrreversibleIndex; z4 <= searchPathKeys.length - 1; z4++) {
            if (searchPathKeys[z4] == curKey) {
                repCount = repCount + 1
            }
        }
        if (repCount >= 3) {
            let staticEval3 = evaluate()
            if (staticEval3 > 30) { return 0 - contemptValue }
            if (staticEval3 < -30) { return contemptValue }
            return 0
        }
    }

    if (effectiveDepth == 0) {
        return quiesce(alpha, beta)
    }
    let maximizing = whiteToMove

    let localFrom = movesFrom
    let localTo = movesTo
    let localPromotion = movesPromotion
    let localCastle = movesCastle
    let localEP = movesEnPassant
    let order = orderMoveIndices(depth, false)
    let best = maximizing ? -32000 : 32000

    for (let k = 0; k <= order.length - 1; k++) {
        let idx = order[k]
        movesFrom = localFrom; movesTo = localTo; movesPromotion = localPromotion
        movesCastle = localCastle; movesEnPassant = localEP

        let sTurn = whiteToMove
        let sWCK = whiteCastleKing
        let sWCQ = whiteCastleQueen
        let sBCK = blackCastleKing
        let sBCQ = blackCastleQueen
        let sEP = enPassant
        let sWHC = whiteHasCastled
        let sBHC = blackHasCastled

        makeMove(idx)
        let sCaptured = captured
        let moveWasIrreversible = (captured != EMPTY) || (Math.abs(piece2) == PAWN)
        let savedIrrevIndex = searchIrreversibleIndex
        if (moveWasIrreversible) { searchIrreversibleIndex = searchPathKeys.length }
        searchPathKeys.push(positionKey())
        let s = 0
        if (searchPly + 1 >= MAX_PLY) {
            // Safety net: this should never actually trigger in normal
            // play (main search is capped at depth 10 + 4 check
            // extensions = 14, far under MAX_PLY), but if it ever did,
            // falling back to quiescence here is correct and safe rather
            // than indexing past the end of the per-ply pools.
            s = quiesce(alpha, beta)
        } else {
            searchPly = searchPly + 1
            s = search(effectiveDepth - 1, alpha, beta, nextExtCount)
            searchPly = searchPly - 1
        }
        searchPathKeys.pop()
        searchIrreversibleIndex = savedIrrevIndex

        // Same reasoning as quiesce() above -- localFrom/localTo/etc, not
        // movesFrom[idx]/movesTo[idx], since the recursive search() call
        // just above reassigned those globals to a deeper ply's arrays.
        unmakeMove(localFrom[idx], localTo[idx], localPromotion[idx], localCastle[idx], localEP[idx], sCaptured); whiteToMove = sTurn
        whiteCastleKing = sWCK; whiteCastleQueen = sWCQ
        blackCastleKing = sBCK; blackCastleQueen = sBCQ
        enPassant = sEP
        whiteHasCastled = sWHC
        blackHasCastled = sBHC

        if (searchAborted) { break }

        if (maximizing) {
            if (s > best) { best = s }
            if (best > alpha) { alpha = best }
        } else {
            if (s < best) { best = s }
            if (best < beta) { beta = best }
        }
        if (beta <= alpha) {
            // This move caused a beta cutoff. If it was a quiet move (not a
            // capture or promotion -- those are already ordered well by
            // SEE), remember it as a killer for this depth and reward it in
            // the history table, so ordering gets better as the search goes.
            if (board[localTo[idx]] == EMPTY && localPromotion[idx] == 0) {
                if (depth >= 0 && depth < KILLER_SLOTS) {
                    if (!(localFrom[idx] == killerFrom1[depth] && localTo[idx] == killerTo1[depth])) {
                        killerFrom2[depth] = killerFrom1[depth]
                        killerTo2[depth] = killerTo1[depth]
                        killerFrom1[depth] = localFrom[idx]
                        killerTo1[depth] = localTo[idx]
                    }
                }
                let histPieceType2 = Math.abs(board[localFrom[idx]])
                let histIdx = (histPieceType2 - 1) * 64 + localTo[idx]
                historyTable[histIdx] = historyTable[histIdx] + depth * depth
            }
            break
        }
    }
    return best
}

// ------------------------------------------------------------
// ROOT SEARCH
// ------------------------------------------------------------
function findBestMove (depth: number): number {
    // searchAborted is a global that search()/quiesce() set to true and that
    // the root loop below checks to bail out early. findBestMoveTimed()'s own
    // loop resets it before each depth it runs, but a PLAIN call to
    // findBestMove() (self-play "by ply", Testing menu "by ply depth") has no
    // such loop around it -- so without this reset, a leftover `true` from
    // some earlier timed search (perfectly normal there: it's how a timed
    // search ends) would make this call give up after trying just its first
    // root move and return an unsearched fallback, even though nothing here
    // is actually time-limited.
    searchAborted = false
    // Seed the search's repetition tracker fresh from the real game's
    // history every time -- positionHistory is already pruned to only
    // contain positions since the last capture/pawn move, so starting
    // the scan window at 0 is correct.
    searchPathKeys = []
    for (let z5 = 0; z5 <= positionHistory.length - 1; z5++) {
        searchPathKeys.push(positionHistory[z5])
    }
    searchIrreversibleIndex = 0
    searchPly = 0

    generateLegalMoves(whiteToMove)
    let rootFrom = movesFrom
    let rootTo = movesTo
    let rootPromotion = movesPromotion
    let rootCastle = movesCastle
    let rootEP = movesEnPassant
    let order = orderMoveIndices(depth, true)
    let maximizing = whiteToMove
    let bestIndexLocal = order[0]
    let bestScore = maximizing ? -32000 : 32000
    // ROOT ALPHA-BETA: every ply below the root already tightens alpha/beta
    // as it goes (see search()'s own "if (best > alpha) alpha = best"), so
    // each sibling move gets searched against a narrower window than the
    // last -- except here, where every root move used to be searched
    // against the same wide-open (-32000, 32000) window regardless of how
    // good earlier moves already looked. That meant none of the pruning
    // benefit from a strong first move ever reached the root's own
    // children. Tightening these exactly the same way fixes that: this is
    // still plain, exact alpha-beta (guaranteed to find the same best move
    // and score as a full-width search), just no longer leaving the root
    // ply itself out of it.
    let rootAlpha = -32000
    let rootBeta = 32000

    for (let k = 0; k <= order.length - 1; k++) {
        let idx = order[k]
        movesFrom = rootFrom; movesTo = rootTo; movesPromotion = rootPromotion
        movesCastle = rootCastle; movesEnPassant = rootEP

        let sTurn = whiteToMove
        let sWCK = whiteCastleKing
        let sWCQ = whiteCastleQueen
        let sBCK = blackCastleKing
        let sBCQ = blackCastleQueen
        let sEP = enPassant
        let sWHC = whiteHasCastled
        let sBHC = blackHasCastled

        makeMove(idx)
        let sCapturedR = captured
        let moveWasIrreversibleR = (captured != EMPTY) || (Math.abs(piece2) == PAWN)
        let savedIrrevIndexR = searchIrreversibleIndex
        if (moveWasIrreversibleR) { searchIrreversibleIndex = searchPathKeys.length }
        searchPathKeys.push(positionKey())
        searchPly = 1
        let s = search(depth - 1, rootAlpha, rootBeta, 0)
        searchPly = 0
        searchPathKeys.pop()
        searchIrreversibleIndex = savedIrrevIndexR

        // Same reasoning as search()/quiesce() -- rootFrom/rootTo/etc, not
        // movesFrom[idx]/movesTo[idx], since the recursive search() call
        // just above reassigned those globals to a deeper ply's arrays.
        unmakeMove(rootFrom[idx], rootTo[idx], rootPromotion[idx], rootCastle[idx], rootEP[idx], sCapturedR); whiteToMove = sTurn
        whiteCastleKing = sWCK; whiteCastleQueen = sWCQ
        blackCastleKing = sBCK; blackCastleQueen = sBCQ
        enPassant = sEP
        whiteHasCastled = sWHC
        blackHasCastled = sBHC

        if (searchAborted) { break }

        if (maximizing) {
            if (s > bestScore) { bestScore = s; bestIndexLocal = idx }
            if (bestScore > rootAlpha) { rootAlpha = bestScore }
        } else {
            if (s < bestScore) { bestScore = s; bestIndexLocal = idx }
            if (bestScore < rootBeta) { rootBeta = bestScore }
        }
    }
    movesFrom = rootFrom; movesTo = rootTo; movesPromotion = rootPromotion
    movesCastle = rootCastle; movesEnPassant = rootEP
    if (!searchAborted) {
        // Remember this depth's best root move so the NEXT (deeper) call
        // from findBestMoveTimed's iterative-deepening loop can try it
        // first -- a cheap, low-risk stand-in for a full transposition
        // table, since the previous iteration's best move is usually still
        // a very strong candidate one ply deeper.
        rootPVFrom = movesFrom[bestIndexLocal]
        rootPVTo = movesTo[bestIndexLocal]
    }
    return bestIndexLocal
}

// ------------------------------------------------------------
// TIME-BUDGETED ITERATIVE DEEPENING
// ------------------------------------------------------------
function findBestMoveTimed (maxMillis: number): number {
    // If there's only one legal move (e.g. in check with a single way out),
    // there's nothing to think about -- play it instantly instead of
    // burning the whole time budget.
    generateLegalMoves(whiteToMove)
    if (movesFrom.length == 1) {
        return 0
    }

    // Hard deadline checked *inside* search()/quiesce() themselves (not just
    // between depths), so a search can be aborted immediately no matter how
    // deep it has recursed. Any depth that gets aborted partway through is
    // discarded entirely -- we fall back to the last fully-completed depth.
    searchStartTime = input.runningTime()
    searchDeadline = searchStartTime + maxMillis
    searchBudgetMillis = maxMillis
    resetSearchMemory()
    animationEnabled = true
    lastLedCount = 0
    lastLedUpdateTime = 0
    debugNodeCount = 0
    lastDebugUpdateTime = 0
    basic.clearScreen()
    let bestIndexOverall = -1
    let depth = 1
    lastCompletedDepth = 0
    while (depth <= 10) {
        searchAborted = false
        let candidate = findBestMove(depth)
        if (searchAborted) {
            // Depth aborted partway through. findBestMove still returns a
            // legal move (it starts from order[0] and only improves from
            // there), so use it as a last-resort fallback if we don't have
            // ANY completed depth yet -- this only matters for absurdly
            // tight time budgets that can't even finish depth 1.
            if (bestIndexOverall < 0) { bestIndexOverall = candidate }
            break
        }
        bestIndexOverall = candidate
        lastCompletedDepth = depth
        depth = depth + 1
        if (input.runningTime() >= searchDeadline) {
            break
        }
    }
    animationEnabled = false
    basic.clearScreen()
    // searchDeadline is a global that search()/quiesce() check unconditionally,
    // no matter who is calling them. If we leave it sitting at the value we
    // set above, it stays stuck in the past forever -- and every future PLAIN
    // findBestMove() call (self-play "by ply", Testing menu "by ply depth")
    // would then abort on its very first node and silently fall back to an
    // unsearched move. Reset it to "no limit" now that this timed search is
    // over, so it can't leak into anything that isn't time-limited.
    searchDeadline = 2147483647
    return bestIndexOverall
}

