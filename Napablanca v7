// Loads the position, runs the configured search on it, shows the board
// with the chosen move already played plus the resulting eval and how
// long the search took, then waits for B to return to the test menu.
function runTestPosition (idx: number): void {
    loadTestPosition(idx)
    drawBoard()
    let startTime = input.runningTime()
    let mv = 0
    let depthText = ""
    if (testSearchMode == 0) {
        mv = findBestMove(testSearchDepth)
        depthText = "Depth: " + testSearchDepth + " (fixed)"
    } else {
        mv = findBestMoveTimed(testSearchMillis)
        // lastCompletedDepth is the deepest ply findBestMoveTimed actually
        // FINISHED within the time budget -- this is the number that
        // answers "did more time actually let it search deeper", which a
        // matching move alone can't (two different depths can agree on
        // the same move, as depth 1 and depth 2 do for at least one of
        // these hand-picked positions).
        depthText = "Depth: " + lastCompletedDepth + " (in time)"
    }
    let elapsedMs = input.runningTime() - startTime
    let moveText = moveName(mv)
    makeMove(mv)
    let evalScore = evaluate()
    showTestResult(testLabels[idx], moveText, evalScore, elapsedMs, depthText)
    let bLast = input.buttonIsPressed(Button.B)
    while (true) {
        let bNow = input.buttonIsPressed(Button.B)
        let bPressed = bNow && !(bLast)
        bLast = bNow
        if (bPressed) {
            break
        }
        basic.pause(100)
    }
}

