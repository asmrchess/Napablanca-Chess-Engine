// Builds outMap[0..63] = true wherever a piece of the given color attacks
// that square, replicating squareAttacked()'s exact rules (same pawn
// direction, same "a slider's ray stops at -- but includes -- the first
// piece it hits, friend or foe" behavior, same knight/king offsets) but
// computed ATTACKER-first in one pass over the board, instead of asking
// "is square X attacked?" freshly (a fresh scan back out from X) for every
// one of the up to ~30 pieces on the board. Same answers, far less work.
function buildAttackMap (byWhite: boolean, outMap: boolean[]): void {
    for (let z6 = 0; z6 <= 63; z6++) {
        outMap[z6] = false
    }
    for (let s = 0; s <= 63; s++) {
        let p3 = board[s]
        if (p3 == EMPTY) { continue }
        if ((p3 > 0) != byWhite) { continue }
        let atype2 = Math.abs(p3)
        let sr = row(s)
        let sc = col(s)
        if (atype2 == PAWN) {
            let dr5 = byWhite ? -1 : 1
            if (onBoard(sr + dr5, sc - 1)) { outMap[squareFromRC(sr + dr5, sc - 1)] = true }
            if (onBoard(sr + dr5, sc + 1)) { outMap[squareFromRC(sr + dr5, sc + 1)] = true }
        } else if (atype2 == KNIGHT) {
            for (let m2 = 0; m2 <= 7; m2++) {
                let nr5 = sr + knightR[m2]
                let nc5 = sc + knightC[m2]
                if (onBoard(nr5, nc5)) { outMap[squareFromRC(nr5, nc5)] = true }
            }
        } else if (atype2 == KING) {
            for (let dr6 = -1; dr6 <= 1; dr6++) {
                for (let dc6 = -1; dc6 <= 1; dc6++) {
                    if (dr6 == 0 && dc6 == 0) { continue }
                    let nr6 = sr + dr6
                    let nc6 = sc + dc6
                    if (onBoard(nr6, nc6)) { outMap[squareFromRC(nr6, nc6)] = true }
                }
            }
        } else {
            if (atype2 == BISHOP || atype2 == QUEEN) {
                for (let d2 = 0; d2 <= 3; d2++) {
                    let nr7 = sr + diagR[d2]
                    let nc7 = sc + diagC[d2]
                    while (onBoard(nr7, nc7)) {
                        let sq7 = squareFromRC(nr7, nc7)
                        outMap[sq7] = true
                        if (board[sq7] != EMPTY) { break }
                        nr7 += diagR[d2]
                        nc7 += diagC[d2]
                    }
                }
            }
            if (atype2 == ROOK || atype2 == QUEEN) {
                for (let e2 = 0; e2 <= 3; e2++) {
                    let nr8 = sr + straightR[e2]
                    let nc8 = sc + straightC[e2]
                    while (onBoard(nr8, nc8)) {
                        let sq8 = squareFromRC(nr8, nc8)
                        outMap[sq8] = true
                        if (board[sq8] != EMPTY) { break }
                        nr8 += straightR[e2]
                        nc8 += straightC[e2]
                    }
                }
            }
        }
    }
}

// Grows the pools lazily, one ply at a time, up to whatever ply the
// search has actually reached -- NOT eagerly up to MAX_PLY all at once.
// MAX_PLY is a worst-case safety cap (see the note above), but a typical
// search never gets remotely close to it: a depth-3 self-play move only
// ever touches a handful of ply levels. Eagerly building all MAX_PLY
// levels' worth of pools up front, before a single move is even played,
// turned out to be its own large allocation -- likely exactly why the
// out-of-memory panic was happening immediately at game start rather
// than partway through a search. Growing only as deep as actually used
// means a shallow search pays for a shallow pool, not a worst-case one.
function initPools (): void {
    while (moveFromPool.length <= searchPly) {
        moveFromPool.push([])
        moveToPool.push([])
        movePromotionPool.push([])
        moveCastlePool.push([])
        moveEPPool.push([])
        boardPool.push([])
        orderPool.push([])
        tacticalValuePool.push([])
        gainPool.push([])
    }
}

